{
  "name": "@sonarithm/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens and React Aria Components wrappers for the SONARITHM desktop app",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/generated/tokens.css",
    "./fonts.css": "./src/generated/fonts.css",
    "./licenses.json": "./src/generated/licenses.json",
    "./stylelint-config": "./stylelint/config.js"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && prettier --check . && stylelint --allow-empty-input \"**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "tokens": "node tokens/generate.ts",
    "storybook": "storybook dev --port 6006 --no-open",
    "build-storybook": "storybook build --quiet",
    "test:stories": "vitest run --project storybook",
    "test:seeded": "node test/seeded/expect-axe-failure.ts",
    "test:visual": "vitest run --project visual"
  },
  "devDependencies": {
    "@sonarithm/i18n": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "eslint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "storybook": "catalog:",
    "stylelint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "dependencies": {
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:"
  }
}
