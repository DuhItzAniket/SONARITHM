# SONARITHM .gitattributes
# Line endings: LF in the repository and in working trees on every platform,
# so that Windows, macOS and Linux contributors produce identical files.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Language-aware diffs
*.rs   diff=rust
*.py   diff=python
*.md   diff=markdown
*.css  diff=css
*.html diff=html

# Data-layer test corpora keep their exact bytes: BOMs, CRLF line endings and legacy
# encodings are what the tests exercise.
crates/sonarithm-data/tests/corpus/** -text
crates/sonarithm-data/fuzz/corpus/** -text

# --- Binary files (no line-ending conversion, no textual diff) -------------
# Audio
*.wav     binary
*.flac    binary
*.mp3     binary
*.ogg     binary
*.opus    binary
*.mid     binary
*.midi    binary
*.sf2     binary
*.sofa    binary
# Images and documents
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.icns    binary
*.pdf     binary
# Data
*.parquet binary
*.arrow   binary
*.feather binary
*.xlsx    binary
*.ods     binary
*.docx    binary
*.pptx    binary
# ML models (Stage D)
*.onnx    binary
*.gguf    binary
# Fonts and archives
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.gz      binary

# --- Git LFS (not enabled) --------------------------------------------------
# Whether golden audio under tests/golden/ is stored with Git LFS is decided in
# phase A05. Do not uncomment these lines before that decision is recorded.
# tests/golden/**/*.wav  filter=lfs diff=lfs merge=lfs -text
# tests/golden/**/*.flac filter=lfs diff=lfs merge=lfs -text
# examples/**/*.parquet  filter=lfs diff=lfs merge=lfs -text

# --- Generated files (collapsed in GitHub diffs, excluded from language stats) --
schemas/**                       linguist-generated=true
packages/ipc/src/generated/**    linguist-generated=true
Cargo.lock                       linguist-generated=true
pnpm-lock.yaml                   linguist-generated=true
