{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RenderManifest",
  "description": "A render manifest.",
  "type": "object",
  "properties": {
    "cues": {
      "description": "The cue sidecar, if one was written.",
      "anyOf": [
        {
          "$ref": "#/$defs/CueInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "data": {
      "description": "The input data.",
      "$ref": "#/$defs/DataInfo"
    },
    "manifestVersion": {
      "description": "The manifest format version (`MANIFEST_VERSION`, currently 2; 1 still reads).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "output": {
      "description": "The audio file.",
      "$ref": "#/$defs/OutputInfo"
    },
    "platform": {
      "description": "Where it ran.",
      "$ref": "#/$defs/Platform"
    },
    "render": {
      "description": "Render settings.",
      "$ref": "#/$defs/RenderSettings"
    },
    "score": {
      "description": "The Score that was rendered.",
      "$ref": "#/$defs/ScoreInfo"
    },
    "sonarithm": {
      "description": "The software that rendered.",
      "$ref": "#/$defs/Software"
    },
    "spec": {
      "description": "The spec it was compiled from.",
      "$ref": "#/$defs/SpecInfo"
    }
  },
  "$comment": "Generated by `cargo xtask codegen` from the sonarithm-export types; do not edit.",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "sonarithm",
    "score",
    "spec",
    "data",
    "render",
    "output",
    "platform"
  ],
  "$defs": {
    "CueInfo": {
      "description": "The WebVTT cue sidecar.",
      "type": "object",
      "properties": {
        "count": {
          "description": "The number of cues.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file": {
          "description": "The file name, with no directory.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "count"
      ]
    },
    "DataInfo": {
      "description": "The input data.",
      "type": "object",
      "properties": {
        "fingerprint": {
          "description": "SHA-256 fingerprint of the data (03 §2).",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "provenance": {
          "description": "The share of values in each provenance class (03 §4), for example `exact: 1.0`.",
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "format": "double"
          }
        },
        "source": {
          "description": "Where it came from, without any directory.",
          "anyOf": [
            {
              "$ref": "#/$defs/DataSource"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "fingerprint",
        "provenance"
      ]
    },
    "DataSource": {
      "description": "A data source: its kind and a name with no directory.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The source kind, such as `file`.",
          "type": "string"
        },
        "name": {
          "description": "The name, with any directory removed.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "name"
      ]
    },
    "OutputInfo": {
      "description": "The audio file and its measured loudness.",
      "type": "object",
      "properties": {
        "bitsPerSample": {
          "description": "Bits per sample.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "channels": {
          "description": "Channels.",
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "file": {
          "description": "The file name, with no directory.",
          "type": "string"
        },
        "format": {
          "description": "`wav` or `flac`.",
          "type": "string"
        },
        "frames": {
          "description": "Frames per channel.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "gainDb": {
          "description": "The static gain applied for loudness normalization, in dB (sound-design §6.3).",
          "type": "number",
          "format": "double"
        },
        "integratedLufs": {
          "description": "Integrated loudness in LUFS (EBU R128), or `None` for silence.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "limitedFrames": {
          "description": "Frames during which the master limiter reduced the level.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "description": "SHA-256 of the file's bytes.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "truePeakDbtp": {
          "description": "True peak in dBTP.",
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "file",
        "format",
        "bitsPerSample",
        "channels",
        "frames",
        "sha256",
        "truePeakDbtp",
        "gainDb",
        "limitedFrames"
      ]
    },
    "Platform": {
      "description": "The OS and CPU architecture of the build.",
      "type": "object",
      "properties": {
        "arch": {
          "description": "`x86_64`, `aarch64`, …",
          "type": "string"
        },
        "os": {
          "description": "`windows`, `linux`, `macos`, …",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "os",
        "arch"
      ]
    },
    "RenderSettings": {
      "description": "Render settings.",
      "type": "object",
      "properties": {
        "blockSize": {
          "description": "The offline block size in frames.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "durationS": {
          "description": "The length in seconds.",
          "type": "number",
          "format": "double"
        },
        "loudnessCompensationPhon": {
          "description": "The ISO 226:2023 loudness level used for compensation (SDR-24), or `None` if off.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mode": {
          "description": "The mode (SDR-36): `analysis`, `presentation` or `monitoring`.",
          "type": "string"
        },
        "sampleRate": {
          "description": "Frames per second.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "seed": {
          "description": "The Score seed (SDR-02).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "sampleRate",
        "blockSize",
        "seed",
        "mode",
        "durationS"
      ]
    },
    "ScoreInfo": {
      "description": "The rendered Score.",
      "type": "object",
      "properties": {
        "hash": {
          "description": "SHA-256 of the canonical Score, `sha256:` and 64 hex digits (05 §4.3).",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "irVersion": {
          "description": "The Score IR version.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "irVersion",
        "hash"
      ]
    },
    "Software": {
      "description": "Versions of the software.",
      "type": "object",
      "properties": {
        "engines": {
          "description": "The engines that contributed, with their versions, from the Score header.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "git": {
          "description": "The git commit of the build, when the caller knows it.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "The SONARITHM version (of `sonarithm-export`, which shares the workspace version).",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "engines"
      ]
    },
    "SpecInfo": {
      "description": "The spec.",
      "type": "object",
      "properties": {
        "embedded": {
          "description": "The canonical spec itself, when embedded."
        },
        "experimental": {
          "description": "The experimental switches that were on (RFC-0006), sorted; left out when none was\n(manifest version 2).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hash": {
          "description": "SHA-256 of the RFC 8785 canonical spec with defaults applied.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "version": {
          "description": "The spec language version, such as `0.1`.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "hash"
      ]
    }
  }
}
