<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>SONARITHM third-party notices</title>
</head>
<body>
<main>
<h1>Third-party notices</h1>
<p>The SONARITHM command line tool includes the following open-source software. Each licence below lists the crates it covers, then its full text.</p>
<h2>Licences used</h2>
<ul>
{{#each overview}}
<li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
{{#each licenses}}
<section>
<h2 id="{{id}}">{{name}}</h2>
<h3>Used by</h3>
<ul>
{{#each used_by}}
<li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</main>
</body>
</html>
